# Copia in .env e compila. .env NON va committato.

DB_URL=jdbc:postgresql://localhost:5432/iltempiodeilibri
DB_USERNAME=postgres
DB_PASSWORD=

# Almeno 32 caratteri casuali: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60

# Utenza master: l'unica che puo' nominare admin
MASTER_USERNAME=simone
MASTER_PASSWORD=
SUPERUSER_EMAIL=master@iltempiodeilibri.it

# Dati dimostrativi (10 sedi, 10 admin, 100 clienti). In produzione: false
DEMO_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
CLIENTE_PASSWORD=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
