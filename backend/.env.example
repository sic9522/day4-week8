# Variabili d'ambiente del backend in locale. I valori veri non stanno mai in un
# file del progetto: si impostano una volta sulla macchina con
#   setx POSTGRES "postgres"
#   setx POSTGRES_PASSWORD "la-tua-password"
# e servono un terminale nuovo per essere visibili.

# PostgreSQL
POSTGRES=postgres
POSTGRES_PASSWORD=la-tua-password

# Indirizzo del database: solo se diverso dal default
# DB_URL=jdbc:postgresql://localhost:5432/day4_week8

# Origini ammesse dal CORS: in locale il default basta,
# su Render vale https://day4-week8-fe.onrender.com
# ALLOWED_ORIGIN=http://localhost:5173

# Su Render non si imposta a mano: la scrive il blueprint dal database.
# DATABASE_URL=
